# PORTUS Fase 2 — plantilla de configuración (CODESTYLE A-7, SPECS §19.2)
# Copiar a config/portus.env y completar valores reales.
#   cp config/portus.env.ejemplo config/portus.env
# config/portus.env está excluido del repositorio por .gitignore (CODESTYLE G-6).
# Nunca registrar este archivo con credenciales reales (S-1).

# --- Enlace serial con el controlador ---
PUERTO_SERIE=/dev/ttyUSB0
BAUDIOS=115200

# --- Broker MQTT (Mosquitto, SPECS §5.5) ---
MQTT_HOST=127.0.0.1
MQTT_PUERTO=1883
MQTT_USUARIO=portus-puente
MQTT_CONTRASENA=cambiar-esta-contrasena
# WebSocket del navegador del sinóptico (§14.1). El broker exige auth
# (mosquitto_dev.conf: allow_anonymous false); la web inyecta este usuario
# de SOLO LECTURA (acl_portus: portus-tablero) en la página para que el
# cliente MQTT del navegador conecte. Debe coincidir con el de mosquitto_passwd.
MQTT_WS_PUERTO=9001
MQTT_TABLERO_USUARIO=portus-tablero
MQTT_TABLERO_CONTRASENA=cambiar-clave-tablero

# --- Base de datos local del puente (SQLite) ---
RUTA_BD=db/portus.db

# --- Tiempos del protocolo (SPECS §4.5, §5.4, §3.4) ---
TIEMPO_LIMITE_COMANDO_S=2
PERIODO_LATIDO_S=5
PERIODOS_SIN_LATIDO=3
PERIODO_PING_S=3

# --- Registro ---
NIVEL_REGISTRO=INFO

# --- Web (SPECS §7.3, §19.2; núcleo de la Etapa 4) ---
# Puerto HTTP del núcleo web, accesible desde la red local (§19.1).
WEB_PUERTO=8000
# Clave que firma la cookie de sesión (S-1: secreto, nunca en el repositorio).
# Genere una con:  python -c "import secrets; print(secrets.token_urlsafe(32))"
WEB_CLAVE_SECRETA=cambiar-esta-clave-secreta
# Expiración de la sesión por inactividad, en minutos (§7.3).
WEB_EXPIRACION_INACTIVIDAD_MIN=30
# Tope absoluto de vida de la cookie, en horas, con sesión activa o no.
WEB_VIDA_MAXIMA_SESION_H=12

# --- Lógica del turno (Etapa 5; SPECS §12.4) ---
# Política de asignación de posiciones del patio: FASE1 es la línea base
# obligatoria; la política optimizada de la Fase 3 se añadirá como nuevo modo.
POLITICA_ASIGNACION=FASE1

# --- Usuarios semilla (opcional, para herramientas/crear_usuarios_semilla.py) ---
# PORTUS_SEMILLA_TERMINAL=...
# PORTUS_SEMILLA_NAVIERA=...
# PORTUS_SEMILLA_AGENTE=...
# PORTUS_SEMILLA_AUTORIDAD=...
# PORTUS_SEMILLA_TRANSPORTISTA=...

# --- Servicio de mensajería (se usa en la Etapa 10; no aplica al puente) ---
# TELEGRAM_BOT_TOKEN=